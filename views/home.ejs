    <!-- Services Section -->
    <section id="services">
        <div class="title-text" data-aos="fade-up">
            <p>OUR SERVICES</p>
            <h1>Luxury Treatments</h1>
        </div>
        <div class="service-grid">
            <div class="service-card" data-aos="fade-up" data-aos-delay="200">
                <img src="/images/massage.png" alt="Massage Services">
                <div class="service-overlay">
                    <h3 class="text-xl font-semibold mb-2">Massage Therapy</h3>
                    <p>Experience ultimate relaxation with our range of therapeutic massages. Choose from Swedish, Deep Tissue, or Hot Stone treatments.</p>
                </div>
            </div>
            <div class="service-card" data-aos="fade-up" data-aos-delay="400">
                <img src="/images/facials.png" alt="Facial Services">
                <div class="service-overlay">
                    <h3 class="text-xl font-semibold mb-2">Luxury Facials</h3>
                    <p>Revitalize your skin with our premium facial treatments. Customized care for all skin types and concerns.</p>
                </div>
            </div>
            <div class="service-card" data-aos="fade-up" data-aos-delay="600">
                <img src="/images/lashes.png" alt="Lash Services">
                <div class="service-overlay">
                    <h3 class="text-xl font-semibold mb-2">Lash Enhancement</h3>
