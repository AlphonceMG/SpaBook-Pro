                </div>
            </div>
            <div class="service-card" data-aos="fade-up" data-aos-delay="800">
                <img src="/images/microblading.png" alt="Microblading Services">
                <div class="service-overlay">
                    <h3 class="text-xl font-semibold mb-2">Perfect Brows</h3>
                    <p>Achieve your dream brows with our expert microblading services. Natural-looking, long-lasting results.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Enhanced Testimonials Section -->
    <section id="testimonials">
