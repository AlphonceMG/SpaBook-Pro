    <!-- Header -->
    <header class="header">
        <div class="nav-container">
            <img src="/images/logo.png" class="logo" alt="Eddah's Spa Logo">
        </div>
    </header>

    <!-- Hero Section -->
    <section id="banner">
        <div class="banner-text">
            <h1>Eddah's Spa</h1>
            <p>Experience Luxury & Wellness</p>
            <div class="banner-btn">
                <a href="/bookings/services" data-aos="fade-up" data-aos-delay="200">
