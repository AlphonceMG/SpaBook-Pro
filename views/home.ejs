                </a>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section id="features">
        <div class="title-text" data-aos="fade-up">
            <p>WHY CHOOSE US</p>
            <h1>Experience the Difference</h1>
        </div>
        <div class="features-box">
            <div class="feature-card" data-aos="fade-up" data-aos-delay="200">
                <div class="feature-icon">
                    <i class='bx bx-check-shield'></i>
                </div>
