<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Eddah's Spa - Luxury Beauty & Wellness</title>
    <!-- Modern CSS Framework -->
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    <!-- Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/boxicons/2.1.4/css/boxicons.min.css">
    <!-- AOS Animation Library -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    
<style>
    /* Custom Styles */
    :root {
        --primary-color: #009688;
        --secondary-color: #00796b;
        --text-color: #333;
        --light-bg: #f8f9fa;
        --accent-color: #ffd700;
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: 'Poppins', sans-serif;
    }

    html {
        scroll-behavior: smooth;
    }

    /* Header & Navigation */
    .header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 1000;
        background: transparent;
        transition: all 0.3s ease;
        padding: 1rem 0;
    }

    .header.scrolled {
        background: rgba(0, 0, 0, 0.8);
        backdrop-filter: blur(10px);
    }

    .nav-container {
        width: 90%;
        max-width: 1200px;
        margin: auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .logo {
        width: 120px;
        transition: all 0.3s ease;
    }

    .logo:hover {
        transform: scale(1.05);
    }

    /* Hero Section */
    #banner {
        background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 150, 136, 0.8)), url(/images/banner.png);
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
    }

    .banner-text {
        text-align: center;
        color: #fff;
        max-width: 800px;
        padding: 0 20px;
    }

    .banner-text h1 {
        font-family: 'Playfair Display', serif;
        font-size: clamp(3rem, 8vw, 6rem);
        font-weight: 700;
        margin-bottom: 1rem;
        opacity: 0;
        animation: fadeInUp 1s ease forwards;
    }

    .banner-text p {
        font-size: clamp(1rem, 2vw, 1.5rem);
        font-weight: 300;
        margin-bottom: 2rem;
        opacity: 0;
        animation: fadeInUp 1s ease 0.3s forwards;
    }

    /* Modern Button Styles */
    .banner-btn {
        display: flex;
        gap: 20px;
        justify-content: center;
        opacity: 0;
        animation: fadeInUp 1s ease 0.6s forwards;
    }

    .banner-btn a {
        padding: 15px 30px;
        color: #fff;
        text-decoration: none;
        border: 2px solid #fff;
        border-radius: 30px;
        font-weight: 500;
        position: relative;
        overflow: hidden;
        transition: all 0.3s ease;
        background: transparent;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .banner-btn a:hover {
        background: var(--primary-color);
        border-color: var(--primary-color);
        transform: translateY(-3px);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
    }

    /* Features Section */
    #features {
        padding: 100px 0;
        background: var(--light-bg);
        position: relative;
        overflow: hidden;
    }

    .title-text {
        text-align: center;
        margin-bottom: 60px;
    }

    .title-text p {
        color: var(--primary-color);
        font-size: 1.2rem;
        font-weight: 600;
        position: relative;
        display: inline-block;
        margin-bottom: 1rem;
    }

    .title-text h1 {
        font-family: 'Playfair Display', serif;
        font-size: clamp(2rem, 4vw, 3rem);
        color: var(--text-color);
    }

    .features-box {
        width: 90%;
        max-width: 1200px;
        margin: auto;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 30px;
        padding: 20px;
    }

    .feature-card {
        background: #fff;
        padding: 30px;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .feature-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 4px;
        background: var(--primary-color);
        transform: scaleX(0);
        transition: transform 0.3s ease;
    }

    .feature-card:hover::before {
        transform: scaleX(1);
    }

    .feature-card:hover {
        transform: translateY(-10px);
    }

    .feature-icon {
        width: 60px;
        height: 60px;
        background: var(--primary-color);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
    }

    .feature-icon i {
        font-size: 30px;
        color: #fff;
    }

    /* Services Section */
    #services {
        padding: 100px 0;
        background: #fff;
    }

    .service-grid {
        width: 90%;
        max-width: 1200px;
        margin: auto;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 30px;
        padding: 20px;
    }

    .service-card {
        position: relative;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        transition: all 0.3s ease;
        aspect-ratio: 4/3;
    }

    .service-card img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .service-card:hover img {
        transform: scale(1.1);
    }

    .service-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        background: linear-gradient(transparent, rgba(0, 0, 0, 0.9));
        padding: 30px;
        color: #fff;
        transform: translateY(100%);
        transition: all 0.3s ease;
    }

    .service-card:hover .service-overlay {
        transform: translateY(0);
    }

    /* Enhanced Testimonials Section */
    #testimonials {
        padding: 120px 0;
        background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
        color: #fff;
        position: relative;
        overflow: hidden;
    }

    #testimonials::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: url('/images/pattern.png');
        opacity: 0.1;
        animation: patternMove 20s linear infinite;
    }

    @keyframes patternMove {
        0% { background-position: 0 0; }
        100% { background-position: 100px 100px; }
    }

    .testimonials-grid {
        width: 90%;
        max-width: 1200px;
        margin: auto;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 40px;
        padding: 20px;
        position: relative;
    }

    .testimonial-card {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        padding: 40px 30px;
        border-radius: 20px;
        text-align: center;
        transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .testimonial-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(
            45deg,
            transparent,
            rgba(255, 255, 255, 0.1),
            transparent
        );
        transform: translateX(-100%);
        transition: 0.5s;
    }

    .testimonial-card:hover {
        transform: translateY(-10px) scale(1.02);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
        border-color: rgba(255, 255, 255, 0.2);
    }

    .testimonial-card:hover::before {
        transform: translateX(100%);
    }

    .testimonial-img-wrapper {
        width: 120px;
        height: 120px;
        margin: 0 auto 25px;
        position: relative;
        z-index: 1;
    }

    .testimonial-img-wrapper::before {
        content: '';
        position: absolute;
        inset: -3px;
        border-radius: 50%;
        padding: 3px;
        background: linear-gradient(45deg, var(--accent-color), transparent);
        -webkit-mask: 
            linear-gradient(#fff 0 0) content-box, 
            linear-gradient(#fff 0 0);
        mask: 
            linear-gradient(#fff 0 0) content-box, 
            linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
    }

    .testimonial-img {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
        transition: all 0.5s ease;
        position: relative;
        z-index: 2;
    }

    .testimonial-card:hover .testimonial-img {
        transform: scale(1.1) rotate(5deg);
    }

    .testimonial-rating {
        color: var(--accent-color);
        font-size: 1.2rem;
        margin: 15px 0;
        display: flex;
        justify-content: center;
        gap: 5px;
    }

    .testimonial-rating i {
        transition: all 0.3s ease;
    }

    .testimonial-card:hover .testimonial-rating i {
        transform: scale(1.2);
    }

    .testimonial-text {
        font-style: italic;
        margin: 20px 0;
        line-height: 1.8;
        position: relative;
        z-index: 1;
        font-size: 1.1rem;
    }

    .testimonial-text::before,
    .testimonial-text::after {
        content: '"';
        font-size: 4rem;
        font-family: 'Playfair Display', serif;
        color: var(--accent-color);
        position: absolute;
        opacity: 0.3;
        transition: all 0.3s ease;
    }

    .testimonial-text::before {
        top: -20px;
        left: -10px;
    }

    .testimonial-text::after {
        bottom: -40px;
        right: -10px;
    }

    .testimonial-card:hover .testimonial-text::before,
    .testimonial-card:hover .testimonial-text::after {
        opacity: 0.6;
        transform: scale(1.2);
    }

    .testimonial-author {
        font-weight: 600;
        color: var(--accent-color);
        font-size: 1.2rem;
        margin: 15px 0 5px;
    }

    .testimonial-date {
        font-size: 0.9rem;
        color: rgba(255, 255, 255, 0.7);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
    }

    .testimonial-date i {
        font-size: 1.1rem;
    }

    /* Add scroll indicator */
    .scroll-indicator {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 3px;
        background: var(--accent-color);
        transform-origin: left;
        transform: scaleX(0);
        z-index: 1001;
    }

    /* Add floating action button */
    .floating-btn {
        position: fixed;
        bottom: 30px;
        right: 30px;
        width: 50px;
        height: 50px;
        background: var(--primary-color);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        cursor: pointer;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
        transition: all 0.3s ease;
        opacity: 0;
        visibility: hidden;
        z-index: 1000;
    }

    .floating-btn.visible {
        opacity: 1;
        visibility: visible;
    }

    .floating-btn:hover {
        background: var(--secondary-color);
        transform: translateY(-5px);
    }

    /* Add loading animation */
    .loading-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 2000;
        transition: opacity 0.5s ease;
    }

    .loading-spinner {
        width: 50px;
        height: 50px;
        border: 3px solid var(--primary-color);
        border-top: 3px solid transparent;
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    /* Footer */
    #footer {
        background: var(--text-color);
        color: #fff;
        padding: 80px 0 20px;
        position: relative;
        overflow: hidden;
    }

    .footer-content {
        width: 90%;
        max-width: 1200px;
        margin: auto;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 40px;
        padding: 20px;
        position: relative;
        z-index: 1;
    }

    .footer-info h3,
    .footer-contact h3,
    .footer-hours h3 {
        color: var(--accent-color);
        margin-bottom: 1.5rem;
    }

    .social-links {
        display: flex;
        gap: 15px;
        margin-top: 20px;
    }

    .social-links a {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: var(--primary-color);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        transition: all 0.3s ease;
    }

    .social-links a:hover {
        transform: translateY(-5px);
        background: var(--accent-color);
    }

    /* Animations */
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Responsive Design */
    @media (max-width: 1024px) {
        .features-box,
        .service-grid,
        .testimonials-grid,
        .footer-content {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 768px) {
        .banner-btn {
            flex-direction: column;
            align-items: center;
        }

        .banner-btn a {
            width: 80%;
            text-align: center;
            justify-content: center;
        }

        .features-box,
        .service-grid,
        .testimonials-grid,
        .footer-content {
            grid-template-columns: 1fr;
        }

        .service-card {
            aspect-ratio: 16/9;
        }
    }
</style>
</head>
<body>
    <!-- Add loading overlay -->
    <div class="loading-overlay">
        <div class="loading-spinner"></div>
    </div>

    <!-- Add scroll indicator -->
