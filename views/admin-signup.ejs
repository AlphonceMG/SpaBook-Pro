<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Signup | SpaBook Pro</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #009688, #004d40);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .signup-container {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
            overflow: hidden;
            width: 100%;
            max-width: 500px;
            padding: 0;
            transition: all 0.3s ease;
        }

        .signup-container:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
        }

        .signup-header {
            background: #009688;
            padding: 30px;
            text-align: center;
            color: white;
        }

        .signup-header h1 {
            font-size: 28px;
            font-weight: 600;
            margin: 0;
        }

        .signup-header p {
            margin: 10px 0 0;
            opacity: 0.9;
        }

        .signup-form {
            padding: 40px;
        }

        .form-floating {
            margin-bottom: 20px;
        }

        .form-floating input {
            border: 2px solid #e0e0e0;
            border-radius: 10px;
            padding: 15px;
            height: 60px;
            transition: all 0.3s;
        }

        .form-floating input:focus {
            border-color: #009688;
            box-shadow: 0 0 0 0.25rem rgba(0, 150, 136, 0.1);
        }

        .form-floating label {
            padding: 1rem;
        }

        .password-toggle {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            color: #666;
            z-index: 10;
        }

        .btn-signup {
            background: #009688;
            border: none;
            border-radius: 10px;
            padding: 15px;
            font-size: 18px;
            font-weight: 500;
            width: 100%;
            margin-top: 20px;
            transition: all 0.3s;
        }

        .btn-signup:hover {
            background: #00796b;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 150, 136, 0.3);
        }

        .validation-message {
            font-size: 0.85rem;
            color: #666;
            margin-top: 5px;
        }

        .alert {
            border-radius: 10px;
            margin-bottom: 20px;
            padding: 15px;
        }

        .password-requirements {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 15px;
            margin-top: 20px;
        }

        .requirement {
            font-size: 0.85rem;
            color: #666;
            margin-bottom: 5px;
        }

        .requirement i {
            margin-right: 5px;
        }

        .requirement.valid {
            color: #009688;
        }

        .requirement.invalid {
            color: #dc3545;
        }
    </style>
</head>
<body>
    <div class="signup-container">
        <div class="signup-header">
            <h1><i class="fas fa-user-shield me-2"></i>Admin Registration</h1>
            <p>Create your administrator account</p>
        </div>

        <div class="signup-form">
            <% if (messages.error) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <%= messages.error %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>

            <form action="/admin/signup" method="POST" id="signupForm" novalidate>
                <div class="form-floating">
                    <input type="email" class="form-control" id="adminEmail" name="adminEmail" placeholder="Email" required>
                    <label for="adminEmail">Email address</label>
                    <div class="validation-message">
                        <i class="fas fa-info-circle"></i> Enter a valid email address
                    </div>
                </div>

                <div class="form-floating position-relative">
                    <input type="password" class="form-control" id="adminPassword" name="adminPassword" placeholder="Password" required>
                    <label for="adminPassword">Password</label>
                    <i class="password-toggle fas fa-eye-slash" onclick="togglePassword('adminPassword')"></i>
                </div>

                <div class="form-floating position-relative">
                    <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" placeholder="Confirm Password" required>
                    <label for="confirmPassword">Confirm Password</label>
                    <i class="password-toggle fas fa-eye-slash" onclick="togglePassword('confirmPassword')"></i>
                </div>

                <div class="password-requirements">
                    <div class="requirement" id="length">
                        <i class="fas fa-circle"></i> Minimum 8 characters
                    </div>
                    <div class="requirement" id="special">
                        <i class="fas fa-circle"></i> At least one special character
                    </div>
                    <div class="requirement" id="match">
                        <i class="fas fa-circle"></i> Passwords match
                    </div>
                </div>

                <button type="submit" class="btn btn-signup text-white">
                    <i class="fas fa-user-plus me-2"></i>Create Admin Account
                </button>
            </form>
        </div>
    </div>

    <!-- Bootstrap JS and dependencies -->
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.min.js"></script>
    
    <script>
        function togglePassword(inputId) {
            const input = document.getElementById(inputId);
            const icon = input.nextElementSibling.nextElementSibling;
            
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            } else {
                input.type = 'password';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            }
        }

        // Real-time password validation
        const adminPassword = document.getElementById('adminPassword');
        const confirmPassword = document.getElementById('confirmPassword');
        const lengthReq = document.getElementById('length');
        const specialReq = document.getElementById('special');
        const matchReq = document.getElementById('match');

        function validatePassword() {
            const password = adminPassword.value;
            const confirm = confirmPassword.value;

            // Length requirement
            if (password.length >= 8) {
                lengthReq.classList.add('valid');
                lengthReq.querySelector('i').classList.remove('fa-circle');
                lengthReq.querySelector('i').classList.add('fa-check-circle');
            } else {
                lengthReq.classList.remove('valid');
                lengthReq.querySelector('i').classList.remove('fa-check-circle');
                lengthReq.querySelector('i').classList.add('fa-circle');
            }

            // Special character requirement
            if (/[!@#$%^&*]/.test(password)) {
                specialReq.classList.add('valid');
                specialReq.querySelector('i').classList.remove('fa-circle');
                specialReq.querySelector('i').classList.add('fa-check-circle');
            } else {
                specialReq.classList.remove('valid');
                specialReq.querySelector('i').classList.remove('fa-check-circle');
                specialReq.querySelector('i').classList.add('fa-circle');
            }

            // Password match requirement
            if (password && confirm && password === confirm) {
                matchReq.classList.add('valid');
                matchReq.querySelector('i').classList.remove('fa-circle');
                matchReq.querySelector('i').classList.add('fa-check-circle');
            } else {
                matchReq.classList.remove('valid');
                matchReq.querySelector('i').classList.remove('fa-check-circle');
                matchReq.querySelector('i').classList.add('fa-circle');
            }
        }

        adminPassword.addEventListener('input', validatePassword);
        confirmPassword.addEventListener('input', validatePassword);

        // Form submission validation
        document.getElementById('signupForm').addEventListener('submit', function(e) {
            const password = adminPassword.value;
            const confirm = confirmPassword.value;
            const email = document.getElementById('adminEmail').value;

            if (!email || !password || !confirm) {
                e.preventDefault();
                alert('Please fill in all fields');
                return;
            }

            if (password.length < 8) {
                e.preventDefault();
                alert('Password must be at least 8 characters long');
                return;
            }

            if (!/[!@#$%^&*]/.test(password)) {
                e.preventDefault();
                alert('Password must contain at least one special character');
                return;
            }

            if (password !== confirm) {
                e.preventDefault();
                alert('Passwords do not match');
                return;
            }
        });
    </script>
</body>
</html>

