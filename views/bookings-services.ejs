<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Spa Services - Eddah's Spa</title>
    <!-- Modern CSS Framework -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/boxicons/2.1.4/css/boxicons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.min.js"></script>

<style>
    :root {
        --primary-color: #009688;
        --secondary-color: #00796b;
        --accent-color: #ffd700;
        --text-dark: #333;
        --text-light: #fff;
        --gradient-1: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
        --gradient-2: linear-gradient(45deg, var(--primary-color), var(--accent-color));
        --gradient-3: linear-gradient(to right, rgba(0, 150, 136, 0.8), rgba(0, 121, 107, 0.8));
    }

    body {
        background: var(--gradient-1);
        color: var(--text-light);
        min-height: 100vh;
        font-family: 'Poppins', sans-serif;
        position: relative;
        overflow-x: hidden;
    }

    body::before {
        content: '';
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: url('/images/pattern.png');
        opacity: 0.05;
        pointer-events: none;
        animation: patternMove 20s linear infinite;
    }

    @keyframes patternMove {
        0% { transform: translate(0, 0); }
        100% { transform: translate(50px, 50px); }
    }

    .page-header {
        text-align: center;
        margin-bottom: 40px;
        position: relative;
    }

    .page-header h1 {
        font-family: 'Playfair Display', serif;
        font-size: 3rem;
        font-weight: 700;
        color: var(--text-light);
        margin: 0;
        padding: 0;
        opacity: 0;
        animation: fadeInDown 1s ease forwards;
    }

    .page-header p {
        font-size: 1.2rem;
        color: rgba(255, 255, 255, 0.9);
        margin-top: 10px;
        opacity: 0;
        animation: fadeInUp 1s ease 0.3s forwards;
    }

    /* Modern Navbar Styling */
    .navbar {
        background: rgba(255, 255, 255, 0.1) !important;
        backdrop-filter: blur(10px);
        border-radius: 15px;
        margin: 20px 0;
        padding: 15px 25px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        animation: slideInDown 1s ease;
    }

    .navbar-brand {
        color: var(--text-light) !important;
        font-family: 'Playfair Display', serif;
        font-size: 1.5rem;
        font-weight: 600;
    }

    .nav-link {
        color: var(--text-light) !important;
        position: relative;
        padding: 8px 15px !important;
        transition: all 0.3s ease;
    }

    .nav-link::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 2px;
        background: var(--accent-color);
        transform: scaleX(0);
        transform-origin: right;
        transition: transform 0.3s ease;
    }

    .nav-link:hover::after {
        transform: scaleX(1);
        transform-origin: left;
    }

    .nav-link.active {
        color: var(--accent-color) !important;
    }

    /* Search Container Styling */
    .search-container {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        padding: 25px;
        margin-bottom: 30px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        animation: fadeIn 1s ease;
    }

    .search-container input {
        background: rgba(255, 255, 255, 0.95);
        border: none;
        border-radius: 30px;
        padding: 15px 25px;
        font-size: 1.1rem;
        transition: all 0.3s ease;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    }

    .search-container input:focus {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
    }

    .service-badge {
        background: var(--gradient-2);
        color: var(--text-light);
        padding: 10px 20px;
        border-radius: 30px;
        font-size: 1.1rem;
        animation: pulse 2s infinite;
    }

    /* Service Categories Styling */
    .service-section {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        border-radius: 25px;
        padding: 30px;
        margin-bottom: 40px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        animation: fadeIn 1s ease;
    }

    .service-section h3 {
        color: var(--text-light);
        font-family: 'Playfair Display', serif;
        font-size: 2rem;
        margin-bottom: 25px;
        position: relative;
        display: inline-block;
    }

    .service-section h3::after {
        content: '';
        position: absolute;
        bottom: -5px;
        left: 0;
        width: 100%;
        height: 2px;
        background: var(--accent-color);
        transform: scaleX(0);
        transform-origin: right;
        transition: transform 0.5s ease;
    }

    .service-section:hover h3::after {
        transform: scaleX(1);
        transform-origin: left;
    }

    .service-card {
        background: rgba(255, 255, 255, 0.95);
        border-radius: 20px;
        padding: 25px;
        margin-bottom: 20px;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .service-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: var(--gradient-2);
        opacity: 0;
        transition: opacity 0.4s ease;
        z-index: 1;
        pointer-events: none;
    }

    .service-card:hover {
        transform: translateY(-8px) scale(1.01);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
    }

    .service-card.selected {
        border: 2px solid var(--accent-color);
        box-shadow: 0 15px 30px rgba(255, 215, 0, 0.2);
    }

    .service-name {
        color: var(--text-dark);
        font-size: 1.3rem;
        font-weight: 600;
        margin-bottom: 10px;
    }

    .service-price {
        color: var(--primary-color);
        font-size: 1.2rem;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .service-price i {
        color: var(--accent-color);
    }

    .service-time {
        color: #666;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 5px;
        margin-top: 5px;
    }

    .service-time i {
        color: var(--primary-color);
    }

    .toggle-service {
        min-width: 50px;
        height: 50px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5em;
        font-weight: bold;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
    }

    .toggle-service::before {
        content: '';
        position: absolute;
        width: 100%;
        height: 100%;
        background: var(--gradient-2);
        top: 0;
        left: 0;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .toggle-service:hover::before {
        opacity: 1;
    }

    .toggle-service.selected {
        background: #dc3545;
        border-color: #dc3545;
        transform: rotate(180deg);
    }

    .toggle-service:not(.selected) {
        background: #28a745;
        border-color: #28a745;
    }

    /* Selected Services Panel */
    #selected-services-list {
        background: rgba(255, 255, 255, 0.95);
        border-radius: 20px;
        padding: 25px;
        margin-top: 20px;
        animation: slideInRight 1s ease;
        box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1);
    }

    .selected-service-item {
        background: #f8f9fa;
        border-radius: 15px;
        padding: 20px;
        margin-bottom: 15px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        transition: all 0.3s ease;
        animation: fadeInLeft 0.5s ease;
        color: var(--text-dark);
    }

    .selected-service-item:hover {
        transform: translateX(5px);
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    }

    .selected-service-item .service-info {
        flex: 1;
    }

    .selected-service-item .fw-bold {
        color: var(--text-dark);
        font-size: 1.1rem;
        margin-bottom: 5px;
    }

    .selected-service-item .text-muted {
        color: #666 !important;
        font-size: 0.95rem;
        line-height: 1.5;
    }

    .selected-services-panel h3 {
        color: var(--text-dark);
        font-family: 'Playfair Display', serif;
        font-size: 1.8rem;
        margin-bottom: 25px;
        padding-bottom: 15px;
        border-bottom: 2px solid var(--primary-color);
    }

    .category-section h5 {
        color: var(--text-dark);
        font-family: 'Playfair Display', serif;
        font-size: 1.4rem;
        margin-bottom: 15px;
        padding-bottom: 8px;
        border-bottom: 1px solid var(--primary-color);
    }

    .total-deposit {
        background: var(--gradient-1);
        color: var(--text-light);
        padding: 25px;
        border-radius: 20px;
        margin: 30px 0;
        font-size: 1.3em;
        text-align: center;
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
    }

    .total-deposit::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(45deg, transparent, rgba(255, 255, 255, 0.1), transparent);
        transform: translateX(-100%);
        transition: transform 0.5s ease;
    }

    .total-deposit:hover::before {
        transform: translateX(100%);
    }

    /* Animations */
    @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    @keyframes fadeInLeft {
        from {
            opacity: 0;
            transform: translateX(-20px);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @keyframes fadeInDown {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes slideInRight {
        from {
            opacity: 0;
            transform: translateX(50px);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @keyframes slideInDown {
        from {
            opacity: 0;
            transform: translateY(-50px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes pulse {
        0% { transform: scale(1); }
        50% { transform: scale(1.05); }
        100% { transform: scale(1); }
    }

    /* Responsive Design */
    @media (max-width: 768px) {
        .page-header h1 {
            font-size: 2.5rem;
        }

        .page-header p {
            font-size: 1.1rem;
        }

        .service-section {
            padding: 20px;
        }

        .service-card {
            padding: 20px;
        }

        .navbar {
            padding: 10px 15px;
        }

        .search-container {
            padding: 20px;
        }

        .selected-services-panel {
            margin-top: 30px;
        }
    }

    /* Add these styles for navigation buttons */
    .navigation-buttons {
        margin-top: 50px !important;
        margin-bottom: 70px !important;
    }

    .page-link {
        background: var(--gradient-1);
        border: none;
        color: var(--text-light) !important;
        padding: 15px 30px;
        border-radius: 30px;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0 10px;
    }

    .page-link:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
        background: var(--gradient-2);
    }

    .page-link i {
        font-size: 1.2em;
        transition: transform 0.3s ease;
    }

    .page-link:hover i.bx-chevron-left {
        transform: translateX(-5px);
    }

    .page-link:hover i.bx-chevron-right {
        transform: translateX(5px);
    }

    .pagination {
        gap: 15px;
    }

    /* Update existing styles */
    .container {
        padding-bottom: 2rem;
    }
</style>
</head>
<body>
    <div class="container py-4">
        <div class="page-header">
            <h1>Spa Services</h1>
            <p>Choose from our exclusive range of luxury treatments</p>
        </div>

        <!-- Navbar -->
        <nav id="navbar-example2" class="navbar navbar-expand-lg">
            <a class="navbar-brand" href="#">Categories</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <i class='bx bx-menu' style="color: white;"></i>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav">
                    <% for (const category of categories) { %>
                    <li class="nav-item">
                        <a class="nav-link" href="#<%= category %>"><%= category %></a>
                    </li>
                    <% } %>
                </ul>
            </div>
        </nav>

        <div class="search-container">
            <input type="text" id="service-search" class="form-control" placeholder="Search services...">
            <div class="d-flex justify-content-between align-items-center mt-3">
                <span class="service-badge" id="service-badge">
                    Selected Services: <span id="selected-services-count">0</span>
                </span>
                <div class="total-deposit" id="total-deposit">Total Deposit: Ksh 0</div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-8">
                <% for (const category in services) { %>
                <section class="service-section" id="<%= category %>">
                    <h3><%= category %></h3>
                    <div class="service-list">
                        <% services[category].forEach((service) => { %>
                        <div class="service-card <%= selectedServices.some(s => s.name === service.name) ? 'selected' : '' %>"
                             data-service-name="<%= service.name %>"
                             data-service-price="<%= service.price %>"
                             data-service-time="<%= service.time %>"
                             data-service-category="<%= category %>">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="service-info">
                                    <h5 class="service-name"><%= service.name %></h5>
                                    <div class="service-price">
                                        <i class='bx bx-money'></i>
                                        Ksh <%= service.price %>
                                    </div>
                                    <div class="service-time">
                                        <i class='bx bx-time'></i>
                                        <%= service.time %> minutes
                                    </div>
                                </div>
                                <button class="btn toggle-service <%= selectedServices.some(s => s.name === service.name) ? 'selected' : '' %>">
                                    <%= selectedServices.some(s => s.name === service.name) ? '-' : '+' %>
                                </button>
                            </div>
                        </div>
                        <% }) %>
                    </div>
                </section>
                <% } %>
            </div>

            <div class="col-lg-4">
                <div class="selected-services-panel">
                    <h3>Selected Services</h3>
                    <div id="selected-services-list">
                        <!-- Will be populated by JavaScript -->
                    </div>
                </div>
            </div>
        </div>

        <!-- Add Navigation Buttons -->
        <div class="navigation-buttons mt-5 mb-4">
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center">
                    <li class="page-item">
                        <a class="page-link" href="/">
                            <i class='bx bx-chevron-left'></i>
                            Back Home
                        </a>
                    </li>
                    <li class="page-item">
                        <a class="page-link" href="/bookings/appointments" id="next-button">
                            Continue to Appointment
                            <i class='bx bx-chevron-right'></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>

    <script>
        // Initialize variables safely
        let selectedServices = [];
        let totalDeposit = 0;

        document.addEventListener('DOMContentLoaded', function() {
            // Initialize data from server-side rendered values
            try {
                const initialData = JSON.parse('<%- JSON.stringify({ selectedServices, totalDeposit }) %>');
                selectedServices = initialData.selectedServices || [];
                totalDeposit = parseFloat(initialData.totalDeposit) || 0;
                
                if (isNaN(totalDeposit)) {
                    totalDeposit = 0;
                }

                // Update initial displays
                updateSelectedServicesDisplay();
                updateTotalDeposit();
                updateSelectedCount();
            } catch (error) {
                console.error('Error initializing data:', error);
                showAlert('Error loading service data. Please refresh the page.', 'danger');
            }

            // Add scroll spy for navigation
            const navLinks = document.querySelectorAll('.nav-link');
            const sections = document.querySelectorAll('.service-section');
            
            window.addEventListener('scroll', () => {
                let current = '';
                sections.forEach(section => {
                    const sectionTop = section.offsetTop;
                    if (pageYOffset >= sectionTop - 200) {
                        current = section.getAttribute('id');
                    }
                });

                navLinks.forEach(link => {
                    link.classList.remove('active');
                    if (link.getAttribute('href').slice(1) === current) {
                        link.classList.add('active');
                    }
                });
            });

            // Search functionality
            const searchInput = document.getElementById('service-search');
            const serviceCards = document.querySelectorAll('.service-card');

            searchInput.addEventListener('input', function(e) {
                const searchTerm = e.target.value.toLowerCase();
                
                serviceCards.forEach(card => {
                    const serviceName = card.querySelector('.service-name').textContent.toLowerCase();
                    const serviceCategory = card.dataset.serviceCategory.toLowerCase();
                    
                    if (serviceName.includes(searchTerm) || serviceCategory.includes(searchTerm)) {
                        card.style.display = '';
                        card.classList.add('animate__animated', 'animate__fadeIn');
                    } else {
                        card.style.display = 'none';
                    }
                });
            });

            // Service selection handling
            document.querySelectorAll('.toggle-service').forEach(button => {
                button.addEventListener('click', async function() {
                    const card = this.closest('.service-card');
                    const serviceName = card.dataset.serviceName;
                    const servicePrice = parseInt(card.dataset.servicePrice);
                    const serviceTime = card.dataset.serviceTime;
                    const serviceCategory = card.dataset.serviceCategory;
                    
                    try {
                        const isSelected = selectedServices.some(s => s.name === serviceName);
                        const action = isSelected ? 'deselect' : 'select';
                        
                        const response = await fetch(`/bookings/services/${action}`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ 
                                serviceName,
                                price: servicePrice,
                                time: serviceTime,
                                category: serviceCategory
                            })
                        });

                        if (!response.ok) {
                            throw new Error(`HTTP error! status: ${response.status}`);
                        }

                        const data = await response.json();
                        
                        if (data.success) {
                            if (isSelected) {
                                selectedServices = selectedServices.filter(s => s.name !== serviceName);
                                card.classList.remove('selected');
                                this.classList.remove('selected');
                                this.textContent = '+';
                            } else {
                                const serviceData = {
                                    name: serviceName,
                                    price: servicePrice,
                                    time: serviceTime,
                                    category: serviceCategory
                                };
                                selectedServices.push(serviceData);
                                card.classList.add('selected');
                                this.classList.add('selected');
                                this.textContent = '-';
                            }

                            // Animate the card
                            card.classList.add('animate__animated', isSelected ? 'animate__shake' : 'animate__pulse');
                            setTimeout(() => {
                                card.classList.remove('animate__animated', 'animate__pulse', 'animate__shake');
                            }, 1000);

                            // Update total deposit with the full price from server response
                            totalDeposit = parseFloat(data.totalDeposit);
                            if (isNaN(totalDeposit)) {
                                totalDeposit = selectedServices.reduce((sum, service) => sum + service.price, 0);
                            }
                            
                            updateSelectedServicesDisplay();
                            updateTotalDeposit();
                            updateSelectedCount();
                            showAlert(data.message, 'success');
                        } else {
                            showAlert(data.message || 'Failed to update service selection', 'danger');
                        }
                    } catch (error) {
                        console.error('Error:', error);
                        showAlert('Failed to process service selection. Please try again.', 'danger');
                    }
                });
            });

            // Handle next button state
            const nextButton = document.getElementById('next-button');
            if (nextButton) {
                const updateNextButtonState = () => {
                    if (selectedServices.length === 0) {
                        nextButton.classList.add('disabled');
                        nextButton.style.opacity = '0.7';
                        nextButton.style.cursor = 'not-allowed';
                    } else {
                        nextButton.classList.remove('disabled');
                        nextButton.style.opacity = '1';
                        nextButton.style.cursor = 'pointer';
                    }
                };

                // Update next button state initially
                updateNextButtonState();

                // Update next button state when services are selected/deselected
                const originalUpdateSelectedServicesDisplay = updateSelectedServicesDisplay;
                updateSelectedServicesDisplay = function() {
                    originalUpdateSelectedServicesDisplay();
                    updateNextButtonState();
                };
            }
        });

        function updateSelectedCount() {
            const countElement = document.getElementById('selected-services-count');
            if (countElement) {
                countElement.textContent = selectedServices.length.toString();
            }
        }

        function updateTotalDeposit() {
            const depositElement = document.getElementById('total-deposit');
            if (depositElement) {
                // Calculate total from the full prices of selected services
                const total = selectedServices.reduce((sum, service) => sum + service.price, 0);
                depositElement.classList.add('animate__animated', 'animate__pulse');
                depositElement.textContent = `Total Deposit: Ksh ${total.toFixed(2)}`;
                setTimeout(() => {
                    depositElement.classList.remove('animate__animated', 'animate__pulse');
                }, 1000);
            }
        }

        function updateSelectedServicesDisplay() {
            const container = document.getElementById('selected-services-list');
            
            if (selectedServices.length === 0) {
                container.innerHTML = '<p class="text-muted text-center">No services selected</p>';
                return;
            }

            // Group services by category
            const servicesByCategory = {};
            selectedServices.forEach(service => {
                if (!servicesByCategory[service.category]) {
                    servicesByCategory[service.category] = [];
                }
                servicesByCategory[service.category].push(service);
            });

            let html = '';
            for (const [category, services] of Object.entries(servicesByCategory)) {
                html += `
                    <div class="category-section mb-4">
                        <h5 class="fw-bold">${category}</h5>
                        <div class="selected-services">`;
                
                services.forEach(service => {
                    html += `
                        <div class="selected-service-item">
                            <div class="service-info">
                                <div class="fw-bold">${service.name}</div>
                                <div class="text-muted">
                                    <i class='bx bx-money'></i> Ksh ${service.price}
                                    <br>
                                    <i class='bx bx-time'></i> ${service.time} minutes
                                </div>
                            </div>
                        </div>`;
                });
                
                html += `</div></div>`;
            }
            
            container.innerHTML = html;
        }

        function showAlert(message, type) {
            const alertHtml = `
                <div class="alert alert-${type} alert-dismissible fade show animate__animated animate__fadeInDown" role="alert">
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>`;
            
            const alertsContainer = document.createElement('div');
            alertsContainer.style.position = 'fixed';
            alertsContainer.style.top = '20px';
            alertsContainer.style.right = '20px';
            alertsContainer.style.zIndex = '1050';
            alertsContainer.innerHTML = alertHtml;
            
            document.body.appendChild(alertsContainer);
            
            setTimeout(() => {
                alertsContainer.querySelector('.alert').classList.add('animate__fadeOutUp');
                setTimeout(() => alertsContainer.remove(), 1000);
            }, 5000);
        }
    </script>
</body>
</html>


